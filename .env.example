# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE_URL: The Supabase Project API URL (used by Express backend).
SUPABASE_URL="https://tmcatkojicknqxkvukux.supabase.co"

# SUPABASE_ANON_KEY: The Supabase Anonymous Client Key (used by Express backend).
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InRtY2F0a29qaWNrbnF4a3Z1a3V4Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODA2ODU3ODAsImV4cCI6MjA5NjI2MTc4MH0.gwzWuxcoLxMMWcNlQNnbZ025YzGzHRf0qgYBt5MEJkk"

# FOR STATIC HOSTING (LIKE GITHUB PAGES):
# Vite requires environment variables to starting with `VITE_` to be packed into the production build.
# Set these variables if you intend to deploy dynamically on static hosting sites!
VITE_SUPABASE_URL="https://tmcatkojicknqxkvukux.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InRtY2F0a29qaWNrbnF4a3Z1a3V4Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODA2ODU3ODAsImV4cCI6MjA5NjI2MTc4MH0.gwzWuxcoLxMMWcNlQNnbZ025YzGzHRf0qgYBt5MEJkk"

